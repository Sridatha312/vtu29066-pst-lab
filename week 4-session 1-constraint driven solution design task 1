import java.util.Set;

class Solution {
    public boolean halvesAreAlike(String s) {
        Set<Character> vowels = Set.of('a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U');
        int mid = s.length() / 2;
        int count = 0;

        for (int i = 0; i < mid; i++) {
            if (vowels.contains(s.charAt(i))) {
                count++;
            }
            if (vowels.contains(s.charAt(i + mid))) {
                count--;
            }
        }

        return count == 0;
    }
}
