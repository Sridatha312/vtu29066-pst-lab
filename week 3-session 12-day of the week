class Solution {
    public String dayOfTheWeek(int day, int month, int year) {
        String[] daysOfWeek = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
        int[] daysInMonths = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        
        // Start counting days from 1971-01-01
        int totalDays = 0;
        
        // Add days for full years between 1971 and (year - 1)
        for (int y = 1971; y < year; y++) {
            totalDays += isLeapYear(y) ? 366 : 365;
        }
        
        // Add days for full months in the given year
        for (int m = 0; m < month - 1; m++) {
            totalDays += daysInMonths[m];
        }
        
        // If the current year is a leap year and month > 2, add 1 day for Feb 29
        if (month > 2 && isLeapYear(year)) {
            totalDays++;
        }
        
        // Add remaining days of the target month
        totalDays += day - 1;
        
        // Jan 1, 1971 was Friday (index 5)
        return daysOfWeek[(totalDays + 5) % 7];
    }
    
    private boolean isLeapYear(int year) {
        return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
    }
}
