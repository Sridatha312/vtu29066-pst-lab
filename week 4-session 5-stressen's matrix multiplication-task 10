import java.io.*;
import java.util.*;

public class Solution {

    public static void matrixRotation(List<List<Integer>> matrixList, int r) {
        int m = matrixList.size();
        int n = matrixList.get(0).size();

        int[][] matrix = new int[m][n];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                matrix[i][j] = matrixList.get(i).get(j);
            }
        }

        int numLayers = Math.min(m, n) / 2;

        for (int layer = 0; layer < numLayers; layer++) {
            int top = layer, bottom = m - 1 - layer;
            int left = layer, right = n - 1 - layer;

            int height = bottom - top + 1;
            int width = right - left + 1;
            int P = 2 * (height + width) - 4;
            int effectiveR = r % P;

            // Collect 1D layer coordinates in CCW order
            int[][] coords = new int[P][2];
            int idx = 0;

            for (int j = left; j < right; j++) coords[idx++] = new int[]{top, j};
            for (int i = top; i < bottom; i++) coords[idx++] = new int[]{i, right};
            for (int j = right; j > left; j--) coords[idx++] = new int[]{bottom, j};
            for (int i = bottom; i > top; i--) coords[idx++] = new int[]{i, left};

            // Extract initial values along the perimeter
            int[] vals = new int[P];
            for (int k = 0; k < P; k++) {
                vals[k] = matrix[coords[k][0]][coords[k][1]];
            }

            // Assign elements to their rotated positions
            for (int k = 0; k < P; k++) {
                int[] pos = coords[k];
                matrix[pos[0]][pos[1]] = vals[(k + effectiveR) % P];
            }
        }

        // Print final matrix
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(matrix[i][j]).append(j == n - 1 ? "" : " ");
            }
            sb.append("\n");
        }
        System.out.print(sb.toString());
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String[] line = br.readLine().trim().split("\\s+");
        int m = Integer.parseInt(line[0]);
        int n = Integer.parseInt(line[1]);
        int r = Integer.parseInt(line[2]);

        List<List<Integer>> matrix = new ArrayList<>();
        for (int i = 0; i < m; i++) {
            String[] rowElements = br.readLine().trim().split("\\s+");
            List<Integer> row = new ArrayList<>();
            for (int j = 0; j < n; j++) {
                row.add(Integer.parseInt(rowElements[j]));
            }
            matrix.add(row);
        }

        matrixRotation(matrix, r);
    }
}
