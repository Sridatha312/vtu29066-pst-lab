import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Read number of lines
        if (!scanner.hasNextInt()) return;
        int n = scanner.nextInt();

        // 2D ArrayList to store variable-length lines
        ArrayList<ArrayList<Integer>> lines = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            int d = scanner.nextInt(); // Number of integers in current line
            ArrayList<Integer> currentLine = new ArrayList<>();
            for (int j = 0; j < d; j++) {
                currentLine.add(scanner.nextInt());
            }
            lines.add(currentLine);
        }

        // Read number of queries
        int q = scanner.nextInt();

        for (int i = 0; i < q; i++) {
            int x = scanner.nextInt(); // Line number (1-based)
            int y = scanner.nextInt(); // Position number (1-based)

            int lineIndex = x - 1;
            int posIndex = y - 1;

            // Check if the query coordinates are within bounds
            if (lineIndex >= 0 && lineIndex < lines.size() &&
                posIndex >= 0 && posIndex < lines.get(lineIndex).size()) {
                System.out.println(lines.get(lineIndex).get(posIndex));
            } else {
                System.out.println("ERROR!");
            }
        }

        scanner.close();
    }
}
